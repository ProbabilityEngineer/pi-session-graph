{
  "name": "pi-session-graph",
  "version": "0.1.8",
  "description": "Session lineage graph tools for Pi",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "homepage": "https://github.com/ProbabilityEngineer/pi-session-graph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProbabilityEngineer/pi-session-graph.git"
  },
  "bugs": {
    "url": "https://github.com/ProbabilityEngineer/pi-session-graph/issues"
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "whole-lineage": "npx tsx scripts/whole-lineage-graph.ts",
    "build": "tsc --project tsconfig.json"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "session",
    "lineage",
    "graph"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0"
  },
  "dependencies": {
    "agent-session-store": "github:ProbabilityEngineer/agent-session-store"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@types/node": "latest",
    "typescript": "latest"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "bin": {
    "pigraph": "dist/bin/pigraph.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "DESIGN.md"
  ]
}
